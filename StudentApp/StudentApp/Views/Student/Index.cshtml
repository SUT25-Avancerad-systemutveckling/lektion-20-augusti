@model StudentApp.Models.StudentViewModel;

<h2>Studenter</h2>
<a asp-controller="Student" asp-action="Add">Lägg till ny student</a>

<form asp-controller="Student" asp-action="Index" method="get">
    <label>Filtrera: <input type="text" name="query" /></label>

    <select name="sortOrder">
        <option value="">Sortering</option>
        <option value="title_asc">Titel A-Ö</option>
        <option value="title_desc">Titel Ö-A</option>
    </select>

    <button type="submit">Filtrera</button>
</form>

<ul>
@foreach (var student in Model.Students)
{
    <li>
        <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id">@student.Name</a>
    </li>
}
</ul>